# Velora TPRM v2.0 — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://velora:changeme@localhost:5432/velora_tprm

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (S3-compatible) ────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=velora-tprm

# ── JWT ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_MINIMUM
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PII Field Encryption (AES-256-GCM) ───────────────────────
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY_HERE_

# ── Application ───────────────────────────────────────────────
APP_NAME=Velora TPRM
APP_VERSION=2.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ── LLM Providers (optional) ─────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Observability (optional) ─────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
