# ═══════════════════════════════════════════════════════════════
# Velora TPRM — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://velora:velora_dev_password@localhost:5432/velora_tprm
POSTGRES_PASSWORD=velora_dev_password

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=velora-evidence
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET_KEY=change-me-to-a-real-secret-key-at-least-32-chars-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Encryption ────────────────────────────────────────────────
# Base64-encoded 256-bit key for AES-256-GCM field encryption
# Generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-base64-encoded-256-bit-key-here

# ── Application ───────────────────────────────────────────────
APP_NAME=Velora TPRM
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── LLM Providers (optional) ─────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Sentry (optional) ────────────────────────────────────────
# SENTRY_DSN=

# ── Service Ports (for local development) ─────────────────────
# auth:          8001
# vendor:        8002
# assessment:    8003
# framework:     8004
# scoring:       8005
# evidence:      8006
# monitoring:    8007
# finding:       8008
# communication: 8009
# reporting:     8010
# admin:         8011
# ai:            8012
# workflow:      8013
# bff:           8000
# web:           3000
